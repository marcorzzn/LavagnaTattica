# Teoria dei giochi
compute_nash_equilibrium(payoff_matrix) -> MixedStrategy
compute_minimax(payoff_matrix) -> Value
solve_milp_assignment(attackers, defenders, payoff_matrix) -> Assignment
compute_wasserstein_transport(mu, nu) -> float
